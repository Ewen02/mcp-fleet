# Copier en ~/apps/mcp-paie-fr/.env sur le VPS (chmod 600).
# Toutes les variables : DEPLOY.md, section « Configuration reference ».

# Domaine public servi par Caddy : le serveur refuse tout autre Host (DNS rebinding).
ALLOWED_HOSTS=mcp-paie-fr.137-74-175-232.sslip.io

# Garde-fou anti-abus par IP, pas un quota : les connecteurs Claude/ChatGPT
# partagent quelques IP entre tous leurs utilisateurs.
RATE_LIMIT_PER_MINUTE=600

LOG_LEVEL=info
