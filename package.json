{
  "name": "mcp-paie-fr",
  "version": "0.4.0",
  "description": "MCP server for French payroll and income tax calculations, built on the open-source URSSAF engine (publicodes + modele-social).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-paie-fr": "dist/stdio.js",
    "mcp-paie-fr-http": "dist/http.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent node --import tsx --test test/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "modele-social": "11.1.0",
    "publicodes": "^1.10.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  }
}
