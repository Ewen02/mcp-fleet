exports[`employer_cost {\"gross_salary\":3200,\"company_headcount\":50} 1`] = `
{
  "content": [
    {
      "type": "text",
      "text": "Gross €3,200.00/month → total employer cost €4,352.03/month.\\nEmployer contributions: €1,152.03/month (after a general reduction of €283.84/month).\\nThe employee receives €2,511.17/month before income tax: the cost is 1.73× the net.\\nAssumptions: Non-executive status (non-cadre); Contract type: CDI; Full-time; Collective agreement: droit commun; Company headcount: 50 employees; Outside Alsace-Moselle; No bonuses, overtime, benefits in kind or meal vouchers; Work-accident rate (taux AT/MP): 2.08% (simulator default; the real rate depends on the company's sector and history).\\nWarning: modele-social 11.1.0 computes the general contribution reduction (RGDU) with the June 2026 minimum wage (SMIC); the live URSSAF simulator uses the January 2026 SMIC (fix published upstream, not yet released on npm). For salaries up to about 3× SMIC, the employer cost may be understated by roughly €5 to €110 per month.\\nWarning: Transport tax (versement mobilité) not included: it applies from 11 employees at a rate set by the commune (up to a few percent of gross salary in large cities). The real employer cost is higher for such companies.\\nSource: URSSAF modele-social 11.1.0 engine, rules as of 2026-07-01 — https://mon-entreprise.urssaf.fr/documentation/salari%C3%A9/co%C3%BBt-total-employeur"
    }
  ],
  "structuredContent": {
    "gross_salary": 3200,
    "period": "monthly",
    "total_employer_cost": 4352.03,
    "employer_contributions": 1152.03,
    "general_reduction": 283.84,
    "net_before_income_tax": 2511.17,
    "cost_to_net_ratio": 1.73,
    "assumptions": [
      "Non-executive status (non-cadre)",
      "Contract type: CDI",
      "Full-time",
      "Collective agreement: droit commun",
      "Company headcount: 50 employees",
      "Outside Alsace-Moselle",
      "No bonuses, overtime, benefits in kind or meal vouchers",
      "Work-accident rate (taux AT/MP): 2.08% (simulator default; the real rate depends on the company's sector and history)"
    ],
    "warnings": [
      "modele-social 11.1.0 computes the general contribution reduction (RGDU) with the June 2026 minimum wage (SMIC); the live URSSAF simulator uses the January 2026 SMIC (fix published upstream, not yet released on npm). For salaries up to about 3× SMIC, the employer cost may be understated by roughly €5 to €110 per month.",
      "Transport tax (versement mobilité) not included: it applies from 11 employees at a rate set by the commune (up to a few percent of gross salary in large cities). The real employer cost is higher for such companies."
    ],
    "source": {
      "engine": "publicodes + modele-social (URSSAF / beta.gouv.fr)",
      "modele_social_version": "11.1.0",
      "reference_date": "2026-07-01",
      "year": 2026,
      "license": "MIT",
      "repository": "https://github.com/betagouv/mon-entreprise/tree/master/modele-social",
      "documentation": "https://mon-entreprise.urssaf.fr/documentation/salari%C3%A9/co%C3%BBt-total-employeur"
    }
  }
}
`;

