{
  "name": "@repo/mcp-kit",
  "version": "0.1.0",
  "description": "Shared runtime for the MCP servers of this repository: HTTP and stdio transports, configuration, logging, rate limiting, telemetry, common schemas.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent node --import tsx --test test/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:"
  }
}
